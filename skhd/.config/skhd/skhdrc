# skhd config — keybindings for yabai (bsp layout)
# reload after edits:  killall skhd  (launchd KeepAlive relaunches it with the new config)
# note: skhd does NOT work with `brew services` — it manages its own launchd agent
# stop/start manually with: skhd --stop-service / skhd --start-service

# ---- focus / stack navigation -------------------------------------------
alt - h : yabai -m window --focus prev
alt - l : yabai -m window --focus next
alt - j : yabai -m space --focus prev
alt - k : yabai -m space --focus next

# ---- swap windows in the stack -------------------------------------------
alt + shift - h : yabai -m window --swap prev
alt + shift - l : yabai -m window --swap next

# ---- toggles --------------------------------------------------------------
# float/unfloat the focused window (unmanaged, moves freely)
alt - f : yabai -m window --toggle float

# fullscreen zoom (leave the tiling tree for the focused window)
alt + shift - f : yabai -m window --toggle zoom-fullscreen

# show/hide a second window beside the focused one (stack -> split view)
alt - d : yabai -m window --toggle zoom-parent-split

# ---- spaces / displays -----------------------------------------------------
# send focused window to prev/next space
alt + shift - j : yabai -m window --space prev
alt + shift - k : yabai -m window --space next

# jump straight to space 1..4 (macOS "ctrl+1" is often taken by apps)
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4

# move focused window to space 1..4 (AeroSpace-style: alt+shift+number)
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4

# move window to space N and follow it there
alt + ctrl - 1 : yabai -m window --space 1; yabai -m space --focus 1
alt + ctrl - 2 : yabai -m window --space 2; yabai -m space --focus 2
alt + ctrl - 3 : yabai -m window --space 3; yabai -m space --focus 3
alt + ctrl - 4 : yabai -m window --space 4; yabai -m space --focus 4

# ---- resize (adjust height/width of focused split) -----------------------
ctrl + alt - h : yabai -m window --resize left:-40:0; yabai -m window --resize right:-40:0
ctrl + alt - l : yabai -m window --resize right:40:0; yabai -m window --resize left:40:0
ctrl + alt - k : yabai -m window --resize top:-40:0; yabai -m window --resize bottom:-40:0
ctrl + alt - j : yabai -m window --resize bottom:40:0; yabai -m window --resize top:40:0

# balance all windows in the space evenly
ctrl + alt - b : yabai -m space --balance

# ---- displays --------------------------------------------------------------
# send focused window to prev/next display
alt + shift - p : yabai -m window --display prev
alt + shift - n : yabai -m window --display next

# jump to prev/next display yourself
alt - p : yabai -m display --focus prev
alt - n : yabai -m display --focus next

# ---- misc -------------------------------------------------------------------
# restart yabai (picks up yabairc changes)
alt - r : yabai --restart-service   # fork's own launchd service (com.asmvik.yabai)
