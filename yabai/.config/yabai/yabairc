#!/usr/bin/env sh

# launchd does not put homebrew on PATH; the rc drives `yabai -m` itself
PATH=/opt/homebrew/bin:$PATH

# layout bsp = windows tiled side-by-side / stacked splits (does not require disabling SIP)
yabai -m config layout bsp

# sketchybar: 40pt tall, top of the built-in display. yabai reserves that space
# so windows never slide under the bar.
yabai -m config external_bar main:40:0

# gaps — sketchybar (40pt, external_bar above) + small margins around tiled area.
# top_padding is measured below the external_bar reserve, so windows sit at 40+10=50pt.
# Paddings are grid-aligned: the cell at font-size 18 + adjust-cell-height 20%
# is 11x27pt, so the Ghostty window must leave a multiple of 27pt vertically
# (minus Ghostty's own 10pt top padding) and a multiple of 11pt horizontally:
#   (1117 - 40 - 10 - bottom - 10) % 27 == 0  ->  bottom = 4   (39 rows)
#   (1728 - left - right - 20)     % 11 == 0  ->  7/7          (154 cols)
yabai -m config left_padding 7
yabai -m config right_padding 7
yabai -m config top_padding 10
yabai -m config bottom_padding 4
yabai -m config window_gap 10

# mouse
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off

# placement
yabai -m config window_placement second_child

yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^QuickTime" manage=off
yabai -m rule --add app="^Raycast$" manage=off
yabai -m rule --add app="^Font Book$" manage=off
yabai -m rule --add app="^Warp$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off

echo "yabai configuration loaded.."
