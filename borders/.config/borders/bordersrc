#!/bin/bash
# borders config — drawn around focused window

options=(
  style=round           # rounded corners
  width=3.0
  hidpi=on              # crisp hairline on Retina

  # themify-managed line below: diagonal gradient ACCENT → ACCENT_2
  active_color="gradient(top_left=0xFF80C8E0,bottom_right=0xFFB0A0D8)"

  inactive_color=0x00000000   # no border on unfocused windows

  # no whitelist: draw the border around every app's focused window
  # (original: whitelist="ghostty,kitty")
)

borders "${options[@]}"
